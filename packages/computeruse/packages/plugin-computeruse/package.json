{
  "name": "@elizaos/plugin-computeruse",
  "version": "0.1.0",
  "description": "Native desktop automation for elizaOS agents — wraps the computeruse Rust/NAPI engine as ElizaOS Service + Actions + Providers (screenshot, click, type, window-tree, run-command).",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "files": ["src", "README.md"],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "lint": "biome check ./src",
    "lint:fix": "biome check --write ./src"
  },
  "dependencies": {
    "@elizaos/core": "workspace:*",
    "@elizaos/computeruse": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "agentConfig": {
    "pluginType": "elizaos:plugin:1.0.0",
    "pluginParameters": {
      "COMPUTERUSE_EXEC_MODE": {
        "type": "string",
        "description": "Exec safety mode for RUN_COMMAND / OPEN_APPLICATION: deny | allowlist | full (default full)",
        "required": false
      }
    }
  },
  "author": "elizaOS",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
