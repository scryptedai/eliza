{
  "name": "@elizaos/plugin-scryptedai",
  "version": "0.1.0",
  "description": "ScryptedAI multimodal generation provider for elizaOS (images, videos, text via api.scrypted.ai)",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "lint": "biome check ./src",
    "lint:fix": "biome check --write ./src"
  },
  "dependencies": {
    "@elizaos/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "author": "elizaOS",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
