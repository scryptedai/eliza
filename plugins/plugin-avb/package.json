{
  "name": "@elizaos/plugin-avb",
  "version": "0.1.0",
  "description": "Autonomous Virtual Being pipeline for elizaOS — character introspection → avatar generation via db-persisted state machine",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "files": ["src", "README.md"],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "lint": "biome check ./src",
    "lint:fix": "biome check --write ./src",
    "slm16:smoke": "bun scripts/slm16-smoke.ts"
  },
  "dependencies": {
    "@elizaos/core": "workspace:*",
    "@elizaos/plugin-scryptedai": "workspace:*",
    "@tensorflow/tfjs": "^4.22.0",
    "sentencepiece-js": "^1.1.0"
  },
  "optionalDependencies": {
    "@tensorflow/tfjs-node": "^4.22.0",
    "@tensorflow/tfjs-node-gpu": "^4.22.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "author": "elizaOS",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
