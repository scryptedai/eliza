{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "../../",
    "baseUrl": "../../",
    "typeRoots": ["../../node_modules/@types"],
    "types": ["node"],
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@elizaos/core": ["./packages/typescript/src/index.node.ts"],
      "@elizaos/core/*": ["./packages/typescript/src/*"],
      "@elizaos/plugin-scryptedai": ["./plugins/plugin-scryptedai/src/index.ts"],
      "@elizaos/plugin-scryptedai/*": ["./plugins/plugin-scryptedai/src/*"]
    }
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
