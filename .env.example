####################################
#### Server Configuration ####
####################################

# Server Port
SERVER_PORT=3000

# Server Host (default: 0.0.0.0)
SERVER_HOST=

# Environment Mode (development/production - affects UI and security)
NODE_ENV=development

# Controls whether the web UI is available
# Set to "true" to force enable, "false" to force disable, or leave unset for automatic behavior
# Default: enabled in development, disabled in production
ELIZA_UI_ENABLE=

# Server authentication token for API access
# When set, all /api/* routes require X-API-KEY header with this value
ELIZA_SERVER_AUTH_TOKEN=

# Express Maximum Payload Size (default: 2mb)
EXPRESS_MAX_PAYLOAD=2mb

####################################
#### Provider Configuration ####
####################################

# Total timeout for all providers running in parallel (in milliseconds)
# When providers exceed this timeout, the pipeline aborts and returns an error message
# Default: 1000 (1 second)
PROVIDERS_TOTAL_TIMEOUT_MS=1000

####################################
#### Database Configuration ####
####################################

# PostgreSQL Connection URL
POSTGRES_URL=

# PGLite Database Directory (or use memory:// for in-memory)
# Alternative to Postgres
PGLITE_DATA_DIR=

####################################
#### AI Model Provider APIs ####
####################################

# OpenAI API Key
OPENAI_API_KEY=

# Google Generative AI API Key
GOOGLE_GENERATIVE_AI_API_KEY=


# Anthropic Claude API Key (Embedding Provider required; will default to local embedding if not provided)
ANTHROPIC_API_KEY=

# OpenRouter API Key (Embedding Provider required; will default to local embedding if not provided)
OPENROUTER_API_KEY=

# Ollama API Endpoint (for local LLM hosting, supports embedding)
OLLAMA_API_ENDPOINT=

# ScryptedAI multimodal generation (images, videos, text) — plugin-scryptedai
# Bearer token (must start with "scrypted_", min 20 chars). Required to start the service.
SCRYPTEDAI_BEARER_TOKEN=
# Webhook signing secret (HMAC-SHA256). Required for the /scryptedai/webhook route.
SCRYPTEDAI_WEBHOOK_SECRET=
# API base URL (default shown; leave unset or empty to use default)
SCRYPTEDAI_BASE_URL=https://api.scrypted.ai

####################################
#### Character & Content Loading ####
####################################

# Remote Character URLs (comma-separated)
REMOTE_CHARACTER_URLS=


####################################
#### Development & Build Control ####
####################################

# Non-interactive CLI Mode (true/false)
ELIZA_NONINTERACTIVE=

####################################
#### Data Directory Configuration ####
####################################

# Base data directory (default: .eliza)
# ELIZA_DATA_DIR=.eliza

# Database directory (default: {ELIZA_DATA_DIR}/.elizadb)
# ELIZA_DATABASE_DIR=

# Characters storage directory (default: {ELIZA_DATA_DIR}/data/characters)
# ELIZA_DATA_DIR_CHARACTERS=

# AI-generated content directory (default: {ELIZA_DATA_DIR}/data/generated)
# ELIZA_DATA_DIR_GENERATED=

# Agent uploads directory (default: {ELIZA_DATA_DIR}/data/uploads/agents)
# ELIZA_DATA_DIR_UPLOADS_AGENTS=

# Channel uploads directory (default: {ELIZA_DATA_DIR}/data/uploads/channels)
# ELIZA_DATA_DIR_UPLOADS_CHANNELS=

####################################
#### Plugin Control ####
####################################
# Note: for all available / required configuration for specific plugins
# Check agentConfig property on their package.json


# Skip loading the bootstrap plugin (any value)
# Do not change if you are not customizing bootstrap with another plugin
IGNORE_BOOTSTRAP=

####################################
#### Computer Use (computeruse-mcp-agent) ####
####################################

# Exec safety mode for gated tools (run_command, write_file, edit_file,
# open_application, execute_browser_script). One of: deny | allowlist | full
# Default: full (legacy behaviour — every gated call is allowed).
COMPUTERUSE_EXEC_MODE=full

# When to elicit user approval for gated calls. One of: off | on-miss | always
#   off      — never ask; allowlist misses are denied outright
#   on-miss  — ask only when a call is not covered by the allowlist
#   always   — ask on every gated call regardless of mode
COMPUTERUSE_EXEC_ASK=off

# Path to the allowlist policy (TOML). Loaded when COMPUTERUSE_EXEC_MODE=allowlist.
# Patterns are glob-matched against the tool subject (e.g. the command line for
# run_command, the path for write_file). Tool-scoped patterns use `tool:pattern`.
COMPUTERUSE_POLICY_PATH=~/.computeruse/policy.toml

# Idempotency cache for tool calls carrying `idempotency_key`. A repeat of the
# same (tool, key) within TTL returns the cached result instead of re-executing.
COMPUTERUSE_IDEMPOTENCY_TTL_SECS=300
COMPUTERUSE_IDEMPOTENCY_MAX_ENTRIES=256
